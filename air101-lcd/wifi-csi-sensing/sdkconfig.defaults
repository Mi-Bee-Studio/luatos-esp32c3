CONFIG_IDF_TARGET="esp32c3"
CONFIG_USB_SERIAL_JTAG_ENABLED=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_CDC=y

# WiFi CSI 感知采集（Sense 页）
CONFIG_ESP_WIFI_CSI_ENABLED=y

CONFIG_FREERTOS_HZ=1000

# 尺寸优化（-Os）：2MB flash 要塞下 OTA 双槽（960K×2），app 必须 <960K
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# OTA 双槽（基线能力：web 刷机）：0xF8000×2，nvs 收缩到 20K 腾 otadata
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# LVGL fonts（ui_common.h 的 UI_LH_* 行高常量与这些字号对应）
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_22=y
# LV 默认字体指到 12 号，14 号才可裁（DEFAULT_MONTSERRAT_14 会强制启用 14）
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_12=y
# 8/14/16 号已裁（UI 只用 12/22；bpm 标签 v2.1 改 12 号）省 flash 换 OTA 双槽
# v2.2: 8 号提示行改用自制子集字体 ui_lat8（fonts/，lv_font_conv 生成 ~2KB），
# 内置 montserrat_8 全量表要 7.7KB，2MB 双槽装不下——保持关闭
CONFIG_LV_FONT_MONTSERRAT_8=n
CONFIG_LV_FONT_MONTSERRAT_14=n
CONFIG_LV_FONT_MONTSERRAT_16=n

# 任务看门狗：超时触发 panic 重启（lvgl_tick 挂狗，5s）
CONFIG_ESP_TASK_WDT_PANIC=y

# 日志编译级 ERROR：为 OTA 双槽腾 flash（wpa/lwip/LVGL 的 INFO 文案是大头）。
# 运行观测走 #S1 遥测与状态 JSON；本地调试可删此二行后 rm sdkconfig 重建恢复 INFO。
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_LOG_MAXIMUM_LEVEL_ERROR=y

# WPA3-SAE 保持开启（2026-09-27 真机教训：家里路由器是
# WPA3-SAE，关掉即无法关联——槽余量 60K 装得下 +20K 的 SAE）。
# OWE(增强开放)仍关：家庭网用不上，省一点。
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n

# ---- OTA 双槽腾挪（v2.1）：UI 只用 label/bar/button/image，裁未用控件 ----
# examples 从不使用（此前一直被编进固件；正确符号是 LV_BUILD_EXAMPLES）
CONFIG_LV_BUILD_EXAMPLES=n
# button/image/observer 零使用（grep ui/*.c app_*.c 验证），一并裁掉
CONFIG_LV_USE_BUTTON=n
CONFIG_LV_USE_IMAGE=n
CONFIG_LV_USE_OBSERVER=n
# flex/grid 布局零使用（UI 用绝对坐标布局），裁掉省 flash
CONFIG_LV_USE_FLEX=n
CONFIG_LV_USE_GRID=n
# 2026-09-27：WPA3-SAE 回归后 app 顶破 960K 槽 0x640；断言整体禁编
# （SILENT 仍编入断言表达式）。0xF8000×2 双槽经 gen_esp32part 实测被
# 64K 对齐强制否决（ota_1 offset 0x108000 invalid），0xF0000×2 已是上限。
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_ARC=n
CONFIG_LV_USE_ARCLABEL=n
CONFIG_LV_USE_BUTTONMATRIX=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CALENDAR_HEADER_ARROW=n
CONFIG_LV_USE_CALENDAR_HEADER_DROPDOWN=n
CONFIG_LV_USE_CANVAS=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LINE=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SLIDER=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_SWITCH=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TEXTAREA=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n
