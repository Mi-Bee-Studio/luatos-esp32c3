## blackbox — 合宙 ESP32-C3 网络探测终端（esp32-blackbox 移植）
# 板级信息见 ../README.zh.md；上游工程见 https://github.com/Mi-Bee-Studio/esp32-blackbox
CONFIG_IDF_TARGET="esp32c3"

# 控制台走原生 USB-Serial-JTAG（本板无 USB-UART 桥；上游 SuperMini 是 UART0）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 本板 2MB flash：OTA 双槽 960K×2 + 64K SPIFFS（基线能力=web 刷机，
# -Os + 断言静默瘦身后 app ~954K 装得下）；USB 刷机仍可用。
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="2MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# 配网热点（本板命名，区别于上游默认 ESP32_Blackbox）
CONFIG_ESP_AP_SSID="blackbox-c3"
CONFIG_ESP_AP_PASSWORD="12345678"
CONFIG_ESP_MAXIMUM_RETRY=5

# 上游工程沿用项
CONFIG_FREERTOS_HZ=1000

# 尺寸优化（-Os）：2MB flash 要塞下 OTA 双槽（960K×2），app 必须 <960K
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_SPIFFS_USE_MTIME=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# 本板无用户 LED——GPIO8 是五键的 UP 键，绝不能当 LED 输出驱动
CONFIG_ESP_STATUS_LED=n

# WPA3-SAE 保持开启（2026-09-27 真机教训：家里路由是 WPA3-SAE，关掉即无法
# 关联）。OWE(增强开放)仍关。SAE +20K 后 ~966K/槽 983K，余量紧，加代码前看尺寸。
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n

# 断言静默（保留检查、去消息字符串）：为 2MB OTA 双槽腾空间
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
